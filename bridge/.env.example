BRIDGE_PORT=8787
BRIDGE_HOST=127.0.0.1
# Generate with: openssl rand -hex 32
BRIDGE_TOKEN=replace-me-with-a-long-random-string
# Comma-separated exact origins allowed for CORS. Leave empty in production
# where the client is loaded from the same origin as the bridge.
BRIDGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
