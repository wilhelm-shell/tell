BRIDGE_PORT=8787
BRIDGE_HOST=127.0.0.1
# Generate with: openssl rand -hex 32
BRIDGE_TOKEN=replace-me-with-a-long-random-string
# Comma-separated exact origins allowed for CORS. Leave empty in production
# where the client is loaded from the same origin as the bridge.
BRIDGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# signal-cli integration. Off by default so the bridge boots without any
# signal-cli install. Turn on once you've linked signal-cli as a secondary
# device to your Signal account.
SIGNAL_CLI_ENABLED=false
SIGNAL_CLI_BIN=signal-cli
SIGNAL_CLI_RPC_HOST=127.0.0.1
SIGNAL_CLI_RPC_PORT=7583
# Where signal-cli keeps its account store. Leave unset to use signal-cli's
# default ($HOME/.local/share/signal-cli). docker-compose.yml pins this to
# the /data volume, so it only matters when running the bridge bare.
# SIGNAL_CLI_DATA_DIR=/path/to/signal-cli-data
